{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server/entrypoint.ts --bundle --platform=node --format=esm --outfile=server/entrypoint.js --packages=external",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js server/entrypoint.js",
    "lint": "tsc --noEmit",
    "server:check": "tsc -p tsconfig.server.json",
    "server:test": "node --import tsx --test server/**/*.test.ts",
    "server:test:integration": "node --import tsx --test server/**/*.integration.test.ts",
    "server:test:refund": "node --import tsx --test server/http/refund-route.test.ts server/transactions/refund-postgres.integration.test.ts",
    "theme:validate": "tsx theme-validator.ts --check",
    "theme:fix": "tsx theme-validator.ts",
    "server:start": "tsx server/entrypoint.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:inspect-schema": "tsx scripts/validate-firestore-schema.ts",
    "telemetry:test": "node --import tsx --test src/services/devPerformanceTracker.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "framer-motion": "^14.3.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.4.2",
    "jose": "6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.13",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
