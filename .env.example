# Provider credentials are server-side only. Never expose secrets to browser bundles.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI Provider (optional server-side adapter).
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_DEFAULT_MODEL="gpt-5.6-luna"
OPENAI_TIMEOUT_MS="30000"

# PRODX application URL.
APP_URL="MY_APP_URL"
