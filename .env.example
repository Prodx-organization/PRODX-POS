# PRODX AI runtime
# Server-side only. Never expose these credentials to browser bundles.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_DEFAULT_MODEL="gemini-3.8-flash"
GEMINI_ALLOWED_MODELS="gemini-3.8-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_TIMEOUT_MS="30000"

# OpenAI Provider (server-side only; not the default PRODX AI runtime provider).
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_DEFAULT_MODEL="gpt-5.6-luna"
OPENAI_TIMEOUT_MS="30000"

# PRODX backend / Supabase
# Server-side only unless prefixed VITE_.
DATABASE_URL="postgresql://..."
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# Browser-safe Supabase configuration.
# These values are intentionally public and may be embedded in the Vite bundle.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Isolated Owner Console Supabase project. Do not repoint the shared app Supabase variables above.
VITE_OWNER_SUPABASE_URL="https://bbxoywnlayduqbrjeixj.supabase.co"
VITE_OWNER_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Same-origin on Vercel. The /auth/* and /organizations/* routes are rewritten to the backend function.
VITE_AUTH_API_BASE_URL="/"

# Optional production networking controls.
NODE_ENV="production"
TRUST_PROXY="1"
