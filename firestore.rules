rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'kamkokaewthodsawat@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidOrganization(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'taxId', 'phone', 'email', 'currency', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 64 && data.slug.matches('^[a-z0-9\\-]+$')
        && (!('taxId' in data) || (data.taxId is string && data.taxId.size() <= 64))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('status' in data) || (data.status in ['active', 'inactive']))
        && data.createdAt is number
        && (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['id', 'orgId', 'name', 'address', 'createdAt'])
        && data.keys().hasOnly(['id', 'orgId', 'name', 'address', 'code', 'phone', 'manager', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.orgId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.address is string && data.address.size() <= 300
        && (!('code' in data) || (data.code is string && data.code.size() <= 64))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('manager' in data) || (data.manager is string && data.manager.size() <= 120))
        && (!('status' in data) || (data.status in ['active', 'inactive']))
        && data.createdAt is number
        && (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidTerminal(data) {
      return data.keys().hasAll(['id', 'branchId', 'name', 'code', 'createdAt'])
        && data.keys().hasOnly(['id', 'branchId', 'orgId', 'name', 'code', 'deviceModel', 'ipAddress', 'paperWidth', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.branchId)
        && (!('orgId' in data) || isValidId(data.orgId))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64 && data.code.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 120))
        && (!('ipAddress' in data) || (data.ipAddress is string && data.ipAddress.size() <= 64))
        && (!('paperWidth' in data) || (data.paperWidth in ['58mm', '80mm']))
        && (!('status' in data) || (data.status in ['active', 'maintenance', 'inactive']))
        && data.createdAt is number
        && (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'entityType', 'entityId', 'action', 'timestamp'])
        && isValidId(data.id)
        && data.entityType in ['organization', 'branch', 'terminal']
        && data.action in ['create', 'update', 'delete', 'cascade_delete']
        && data.timestamp is number;
    }

    function isValidDiagnosticLog(data) {
      return data.keys().hasAll(['id', 'batchId', 'category', 'level', 'event', 'message', 'timestamp', 'flushedAt'])
        && isValidId(data.id)
        && isValidId(data.batchId)
        && data.category in ['printer', 'scanner', 'drawer', 'edc', 'display', 'scale', 'system', 'network']
        && data.level in ['TRACE', 'DEBUG', 'INFO', 'WARN', 'ERROR', 'CRITICAL']
        && data.event is string && data.event.size() >= 1 && data.event.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && data.timestamp is number
        && data.flushedAt is number;
    }

    match /organizations/{orgId} {
      allow get: if isValidId(orgId);
      allow list: if true;
      allow create: if isValidId(orgId) && isValidOrganization(incoming()) && incoming().id == orgId;
      allow update: if isValidId(orgId) && isValidOrganization(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(orgId);
    }

    match /branches/{branchId} {
      // Record-level security: only get valid branch document, and list queries MUST match valid orgId
      allow get: if isValidId(branchId);
      allow list: if resource.data.orgId is string && isValidId(resource.data.orgId);
      allow create: if isValidId(branchId) && isValidBranch(incoming()) && incoming().id == branchId;
      allow update: if isValidId(branchId) && isValidBranch(incoming()) && incoming().id == existing().id && incoming().orgId == existing().orgId && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(branchId);
    }

    match /terminals/{terminalId} {
      // Record-level security: only get valid terminal document, and list queries MUST match valid branchId
      allow get: if isValidId(terminalId);
      allow list: if resource.data.branchId is string && isValidId(resource.data.branchId);
      allow create: if isValidId(terminalId) && isValidTerminal(incoming()) && incoming().id == terminalId;
      allow update: if isValidId(terminalId) && isValidTerminal(incoming()) && incoming().id == existing().id && incoming().branchId == existing().branchId && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(terminalId);
    }

    match /audit_logs/{logId} {
      // Immutable real-time audit trail for administrative CRUD operations
      allow get, list: if true;
      allow create: if isValidId(logId) && isValidAuditLog(incoming()) && incoming().id == logId;
      allow update, delete: if false;
    }

    match /diagnostic_logs/{logId} {
      // Immutable batch-uploaded diagnostic log events from POS terminals and peripherals
      allow get, list: if true;
      allow create: if isValidId(logId) && isValidDiagnosticLog(incoming()) && incoming().id == logId;
      allow update, delete: if false;
    }
  }
}
