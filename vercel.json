{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/organizations/:path*",
      "destination": "/api/index.ts"
    }
  ]
}
